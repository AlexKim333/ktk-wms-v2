# ==========================================
# KTK WMS Frontend Environment Variables Template
# Copy this file to .env or .env.local for local development.
# ==========================================

# 1. ERPNext / Frappe Backend URL
VITE_ERPNEXT_URL="https://ktkpos.frappe.cloud"

# 2. Local Admin / Setup Scripts API Credentials (Optional - Do not commit actual keys)
# VITE_API_KEY="your_frappe_api_key_here"
# VITE_API_SECRET="your_frappe_api_secret_here"

# 3. Google Gemini API Key (Samdori Voice Assistant)
# Note: Restrict this key via HTTP Referrers in Google Cloud Console
VITE_GEMINI_API_KEY="your_gemini_api_key_here"
